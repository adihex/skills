#!/usr/bin/env bash
set -euo pipefail

step() {
  local label=$1
  shift
  printf '==> %s\n' "$label"
  time "$@"
}

python_is_supported() {
  command -v python3 >/dev/null 2>&1 &&
    python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 10))'
}

git_is_supported() {
  local version
  command -v git >/dev/null 2>&1 || return 1
  version=$(git version | awk '{print $3}')
  printf '2.30\n%s\n' "$version" | sort -V -C
}

missing_packages=()

if ! python_is_supported; then
  missing_packages+=(python3)
fi

if ! git_is_supported; then
  missing_packages+=(git)
fi

command -v lsof >/dev/null 2>&1 || missing_packages+=(lsof)
command -v shellcheck >/dev/null 2>&1 || missing_packages+=(shellcheck)

if ((${#missing_packages[@]})); then
  step "Refresh Debian package metadata" sudo apt-get update
  step "Install repository toolchain: ${missing_packages[*]}" \
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing_packages[@]}"
else
  printf '==> Repository toolchain is already installed\n'
fi

if ! python_is_supported; then
  printf 'error: Python 3.10+ is required; resolved %s (%s)\n' \
    "$(command -v python3 || printf 'no executable')" "$(python3 --version 2>&1 || printf 'version unavailable')" >&2
  exit 1
fi

if ! git_is_supported; then
  printf 'error: Git 2.30+ is required; resolved %s (%s)\n' \
    "$(command -v git || printf 'no executable')" "$(git version 2>&1 || printf 'version unavailable')" >&2
  exit 1
fi

step "Verify Python sources compile" python3 -m compileall -q skills scripts tests

printf '==> Orb setup complete\n'

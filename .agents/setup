#!/usr/bin/env bash
set -euo pipefail

step() {
  local label=$1
  shift
  printf '==> %s\n' "$label"
  time "$@"
}

missing_packages=()

if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 10))'; then
  missing_packages+=(python3)
fi

if ! command -v git >/dev/null 2>&1 || ! printf '2.30\n%s\n' "$(git version | awk '{print $3}')" | sort -V -C; then
  missing_packages+=(git)
fi

command -v lsof >/dev/null 2>&1 || missing_packages+=(lsof)
command -v shellcheck >/dev/null 2>&1 || missing_packages+=(shellcheck)

if ((${#missing_packages[@]})); then
  step "Refresh Debian package metadata" sudo apt-get update
  step "Install repository toolchain: ${missing_packages[*]}" \
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing_packages[@]}"
else
  printf '==> Repository toolchain is already installed\n'
fi

step "Verify Python sources compile" python3 -m compileall -q skills scripts tests

printf '==> Orb setup complete\n'

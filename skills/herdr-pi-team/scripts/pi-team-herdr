#!/usr/bin/env python3
"""JSON-first Herdr worker lifecycle CLI.

All Herdr calls use one explicit session and all targeting uses manifest pane IDs.
"""
from __future__ import annotations

import argparse
import glob
import importlib.util
import json
import os
import subprocess
import sys
import time
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent

def load(name: str, filename: str):
    spec = importlib.util.spec_from_file_location(name, SCRIPT_DIR / filename)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module

adapter_module = load("herdr_adapter", "herdr_adapter.py")
store_module = load("manifest_store", "manifest_store.py")
cleanup_module = load("cleanup", "cleanup.py")
git_gate_module = load("git_gate", "git_gate.py")
state_module = load("run_state", "run_state.py")
modern_module = load("modern_adapter", "modern_adapter.py")
mailbox_module = load("mailbox", "mailbox.py")
dispatch_spec = importlib.util.spec_from_file_location("shared_dispatch_control_herdr", Path(__file__).resolve().parents[3] / "scripts" / "dispatch_control.py")
if dispatch_spec is None or dispatch_spec.loader is None:
    raise ImportError("shared dispatch control is unavailable")
dispatch_module = importlib.util.module_from_spec(dispatch_spec)
sys.modules[dispatch_spec.name] = dispatch_module
dispatch_spec.loader.exec_module(dispatch_module)

NAME = "pi-team-herdr"
VERSION = "0.4.1"


def emit(value):
    print(json.dumps(value, ensure_ascii=False, indent=2))


def fail(code: int, error_code: str, message: str, suggestion: str | None = None):
    value = {"error": True, "code": error_code, "message": message}
    if suggestion:
        value["suggestion"] = suggestion
    print(json.dumps(value, ensure_ascii=False), file=sys.stderr)
    raise SystemExit(code)


def _shorten_path(value: str, limit: int = 48) -> str:
    """Shorten long filesystem paths for TUI display without truncation confusion.

    Replaces $HOME with ~ and middle-truncates with … when still too long,
    preserving both prefix and suffix so the mailbox/worktree remains identifiable.
    """
    if not value:
        return value
    home = os.path.expanduser("~")
    if value.startswith(home):
        value = "~" + value[len(home):]
    if len(value) <= limit:
        return value
    keep = limit - 1
    left = keep // 2
    right = keep - left
    return value[:left] + "…" + value[-right:]


def _human_events(events: list[dict], mailbox_path: str) -> None:
    if not events:
        print(f"inbox empty · mailbox {_shorten_path(mailbox_path)}")
        return
    width = max(len(e.get("worker", "")) for e in events)
    for event in events:
        worker = event.get("worker", "?")
        kind = event.get("kind", "")
        outcome = event.get("outcome", "")
        if kind == "worker.turn_finished":
            symbol = "✓"
            result = event.get("result") or ""
            preview = result.splitlines()[0][:72] if result else ""
            suffix = f" — {preview}" if preview else ""
            print(f"{symbol} {worker:<{width}}  {outcome} {suffix}")
        elif kind == "worker.blocked":
            symbol = "◐ blocked"
            print(f"{symbol} {worker:<{width}}  needs intervention")
        else:
            print(f"• {worker:<{width}}  {kind}/{outcome}")
    print(f"— {len(events)} event(s) from {_shorten_path(mailbox_path)}")


def _human_launch(payload: dict) -> None:
    mailbox = payload.get("mailbox")
    mailbox_str = f" · mailbox {_shorten_path(str(mailbox))}" if mailbox else ""
    print(f"✓ launched {payload.get('worker')} → workspace {payload.get('workspaceId')} pane {payload.get('paneId')}{mailbox_str}")
    if payload.get("workspaceId"):
        print(f"  status: {payload.get('nativeStatus')}  cwd: {_shorten_path(str(payload.get('workspaceId')))}")


class Parser(argparse.ArgumentParser):
    def error(self, message):
        fail(1, "USAGE", message, "run pi-team-herdr --help")


def branch_for(cwd: str) -> str:
    result = subprocess.run(["git", "-C", cwd, "branch", "--show-current"], capture_output=True, text=True, timeout=20, shell=False)
    return result.stdout.strip() if result.returncode == 0 and result.stdout.strip() else "unknown"


def modern_adapter(args):
    return modern_module.ModernHerdrAdapter(args.herdr_command, args.session, args.timeout)


def prompt_text(args):
    if getattr(args, "file", None):
        return modern_module.ModernHerdrAdapter.read_prompt(args.file)
    if getattr(args, "text", None):
        return args.text
    raise modern_module.ModernAdapterError("PROMPT_REQUIRED", "provide --file or --text")


def modern_error(exc):
    fail(3 if exc.safety else 2, exc.code, str(exc), json.dumps(exc.details, sort_keys=True) if exc.details else None)


def enrich_mailbox_events(events):
    enriched = []
    for event in events:
        value = dict(event)
        artifact = value.get("sessionArtifact")
        if value.get("kind") == "worker.turn_finished" and artifact:
            value["result"] = modern_module.ModernHerdrAdapter.read_final_result(str(artifact))
        enriched.append(value)
    return enriched


def observe_mailbox(modern, mailbox, registrations):
    terminal = mailbox.terminal_workers([worker["name"] for worker in registrations])
    active = [worker for worker in registrations if worker["name"] not in terminal]
    if not active:
        return
    for registration, worker in modern.observe_registered_workers(active):
        inspection = modern.inspect_worker(worker)
        if inspection["interpretation"] == "blocked":
            mailbox.append_event(registration, kind="worker.blocked", outcome="blocked",
                                 native_status=inspection["nativeStatus"], state_change_seq=inspection.get("lastActivity"),
                                 session_artifact=inspection.get("sessionArtifact"))
        elif inspection["interpretation"] == "completed":
            if not inspection.get("sessionArtifact"):
                worker = modern.get_worker(registration["name"])
                if (str(worker.get("workspace_id") or "") != registration["workspace_id"]
                        or str(worker.get("pane_id") or "") != registration["pane_id"]):
                    raise modern_module.ModernAdapterError("WORKER_IDENTITY_CONFLICT", "registered worker identity changed", details={"name": registration["name"]}, safety=True)
                inspection = modern.inspect_worker(worker)
            artifact = inspection.get("sessionArtifact")
            if artifact and modern_module.ModernHerdrAdapter.read_final_result(str(artifact)) is not None:
                mailbox.append_event(registration, kind="worker.turn_finished", outcome="done",
                                     native_status=inspection["nativeStatus"], state_change_seq=inspection.get("lastActivity"),
                                     session_artifact=artifact)


def await_mailbox(modern, mailbox, *, names, consumer, wait_all, timeout, poll_min, poll_max):
    registrations = mailbox.workers(names)
    selected = [worker["name"] for worker in registrations]
    deadline = time.monotonic() + timeout
    delay = poll_min
    while True:
        terminal = mailbox.terminal_workers(selected)
        if wait_all and terminal.issuperset(selected):
            events = mailbox.deliver(consumer=consumer, names=selected)
            return {"waitSatisfied": True, "mode": "all", "events": enrich_mailbox_events(events), "pending": []}
        if not wait_all:
            events = mailbox.deliver(consumer=consumer, names=selected, limit=1)
            if events:
                pending = [name for name in selected if name not in mailbox.terminal_workers(selected)]
                return {"waitSatisfied": True, "allTerminal": not pending, "mode": "any", "events": enrich_mailbox_events(events), "pending": pending}
            if terminal.issuperset(selected):
                return {"waitSatisfied": True, "allTerminal": True, "mode": "any", "events": [], "pending": []}

        observe_mailbox(modern, mailbox, registrations)
        terminal = mailbox.terminal_workers(selected)
        if wait_all and terminal.issuperset(selected):
            events = mailbox.deliver(consumer=consumer, names=selected)
            return {"waitSatisfied": True, "mode": "all", "events": enrich_mailbox_events(events), "pending": []}
        if not wait_all:
            events = mailbox.deliver(consumer=consumer, names=selected, limit=1)
            if events:
                pending = [name for name in selected if name not in mailbox.terminal_workers(selected)]
                return {"waitSatisfied": True, "allTerminal": not pending, "mode": "any", "events": enrich_mailbox_events(events), "pending": pending}

        remaining = deadline - time.monotonic()
        if remaining <= 0:
            pending = [name for name in selected if name not in terminal]
            raise modern_module.ModernAdapterError("WAIT_TIMEOUT", "workers did not produce a terminal mailbox event before the deadline", details={"pending": pending})
        time.sleep(min(delay, remaining))
        delay = min(poll_max, delay * 2)

def adapter(args):
    config = {"backend": getattr(args, "backend", "pi")}
    if getattr(args, "command", None) in {"send", "status", "cleanup"} and getattr(args, "manifest", None):
        saved = store_module.ManifestStore.from_path(args.manifest).read() or {}
        if saved.get("backend"):
            config["backend"] = saved["backend"]
            config.update(saved.get("backend_config") or {})
    for key in ("provider", "model", "effort", "mode", "auth_source", "hax_min_version"):
        value = getattr(args, key, None)
        if value is not None and key not in config:
            config[key] = value
    try:
        return adapter_module.HerdrAdapter(session=args.session, herdr_command=args.herdr_command,
                                           pi_command=args.pi_command, extension=args.extension,
                                           timeout=args.timeout, poll_interval=args.poll_interval,
                                           backend_config=config, hax_command=args.hax_command,
                                           codex_command=args.codex_command, auth_path=args.auth_path)
    except (adapter_module.hax_backend.HaxConfigError, adapter_module.hax_backend.HaxPreflightError) as exc:
        raise adapter_module.AdapterError(getattr(exc, "code", "HAX_CONFIG_INVALID"), str(exc), details=getattr(exc, "details", {})) from exc


def read_manifest(path: str):
    value = store_module.ManifestStore.from_path(path).read()
    if not value:
        fail(2, "MANIFEST_UNREADABLE", "manifest is missing or invalid", "create the manifest with launch")
    return value


def write_manifest(path: str | None, value: dict):
    if path:
        store_module.ManifestStore.from_path(path).write(value)


def resolve_manifest_path(args) -> str:
    if getattr(args, "manifest", None):
        return args.manifest
    run_id = getattr(args, "run_id", None)
    directory = getattr(args, "manifest_dir", None)
    if not run_id or not directory:
        fail(1, "USAGE", "reconcile needs --manifest or --run RUN_ID with --manifest-dir DIR")
    matches = []
    for path in sorted(glob.glob(os.path.join(directory, "*.json"))):
        value = cleanup_module.load_manifest(path)
        if value and value.get("run_id") == run_id:
            matches.append(path)
    if len(matches) != 1:
        fail(2, "MANIFEST_NOT_UNIQUE", "run ID must resolve to exactly one manifest", f"found {len(matches)} matches")
    return matches[0]


def completion_evidence(args, manifest, report_path):
    git = git_gate_module.GitGate(git_command=args.git_command, gh_command=args.gh_command)
    git_evidence = git.verify_worktree(worktree=manifest["worktree"], expected_worktree=manifest["worktree"],
                                       expected_branch=manifest["branch"], require_upstream=True)
    report = git_gate_module.parse_worker_report(report_path, expected_worktree=manifest["worktree"], expected_branch=manifest["branch"])
    pr = git.discover_pr(branch=manifest["branch"], explicit_pr=args.pr)
    pr_number = int(pr.get("number") or 0)
    if report["PR"] != str(pr_number):
        raise git_gate_module.GateError("REPORT_PR_MISMATCH", "report PR does not match discovered PR")
    reviews = git.retrieve_reviews(repository=args.repository, pr_number=pr_number)
    checks = git.poll_checks(repository=args.repository, commit_sha=git_evidence["head_sha"], pr_number=pr_number)
    result = git_gate_module.completion_gate(git=git_evidence, review_status=reviews["review_status"], checks_status=checks["status"])
    if not result["ok"]:
        raise git_gate_module.GateError("COMPLETION_BLOCKED", result["reason"], details={"state": result["state"], "review": reviews["review_status"], "checks": checks["status"]})
    evidence = {"head_sha": git_evidence["head_sha"], "pushed_sha": git_evidence["pushed_sha"], "pr_number": pr_number,
                "review_status": "approved", "checks_status": checks["status"], "worktree_clean": True, "synchronized": True}
    return evidence, {"git": git_evidence, "report": report, "pr": pr, "reviews": reviews, "checks": checks, "completion": result}


def main(argv=None):
    parser = Parser(prog=NAME)
    parser.add_argument("--session", help="one session name used for every Herdr command")
    parser.add_argument("--backend", choices=["pi", "hax"], default="pi")
    parser.add_argument("--provider", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--model", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--effort", choices=["default", "none", "low", "medium", "high", "xhigh", "max"], default=None, help=argparse.SUPPRESS)
    parser.add_argument("--mode", choices=["interactive", "oneshot"], default=None, help=argparse.SUPPRESS)
    parser.add_argument("--auth-source", dest="auth_source", choices=["codex_cli", "hax_managed"], default=None, help=argparse.SUPPRESS)
    parser.add_argument("--hax-min-version", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--hax-command", default="hax", help=argparse.SUPPRESS)
    parser.add_argument("--codex-command", default="codex", help=argparse.SUPPRESS)
    parser.add_argument("--auth-path", default=None, help=argparse.SUPPRESS)
    parser.add_argument("--herdr-command", default="herdr", help=argparse.SUPPRESS)
    parser.add_argument("--git-command", default="git", help=argparse.SUPPRESS)
    parser.add_argument("--gh-command", default="gh", help=argparse.SUPPRESS)
    parser.add_argument("--pi-command", default="pi", help=argparse.SUPPRESS)
    parser.add_argument("--extension", default="~/.pi/agent/extensions/team.ts", help=argparse.SUPPRESS)
    parser.add_argument("--timeout", type=float, default=20.0, help=argparse.SUPPRESS)
    parser.add_argument("--poll-interval", type=float, default=0.2, help=argparse.SUPPRESS)
    parser.add_argument("--version", action="store_true")
    parser.add_argument("--brief", action="store_true")
    sub = parser.add_subparsers(dest="command")

    list_parser = sub.add_parser("list")
    list_parser.add_argument("--human", action="store_true")
    doctor = sub.add_parser("doctor")
    doctor.add_argument("--backend", choices=["pi", "hax"], default=argparse.SUPPRESS)
    doctor.add_argument("--provider", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    doctor.add_argument("--model", default="__doctor_missing__", help=argparse.SUPPRESS)
    doctor.add_argument("--effort", choices=["default", "none", "low", "medium", "high", "xhigh", "max"], default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    doctor.add_argument("--mode", choices=["interactive", "oneshot"], default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    doctor.add_argument("--auth-source", dest="auth_source", choices=["codex_cli", "hax_managed"], default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    doctor.add_argument("--hax-min-version", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    doctor.add_argument("--hax-command", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    doctor.add_argument("--codex-command", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    doctor.add_argument("--auth-path", default=argparse.SUPPRESS, help=argparse.SUPPRESS)

    launch = sub.add_parser("launch")
    launch.add_argument("--name", required=True)
    launch.add_argument("--brief-file", required=True)
    launch.add_argument("--run-id", default=None)
    launch.add_argument("--cwd", default=os.getcwd())
    launch.add_argument("--worktree", default=None)
    launch.add_argument("--branch", default=None)
    launch.add_argument("--workspace", default=None)
    launch.add_argument("--manifest", default=None)
    launch.add_argument("--mailbox", default=None, help="register the worker in this durable run mailbox")
    launch.add_argument("--backend", choices=["pi", "hax"], default=argparse.SUPPRESS)
    launch.add_argument("--provider", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    launch.add_argument("--model", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    launch.add_argument("--effort", choices=["default", "none", "low", "medium", "high", "xhigh", "max"], default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    launch.add_argument("--mode", choices=["interactive", "oneshot"], default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    launch.add_argument("--auth-source", dest="auth_source", choices=["codex_cli", "hax_managed"], default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    launch.add_argument("--hax-min-version", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    launch.add_argument("--hax-command", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    launch.add_argument("--codex-command", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    launch.add_argument("--auth-path", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    launch.add_argument("--thinking", choices=["off", "minimal", "low", "medium", "high", "xhigh", "max"])

    launch.add_argument("--setup-timeout", type=float, default=30.0)
    launch.add_argument("--new-workspace", action="store_true", help="create an isolated workspace (modern Herdr lifecycle)")
    launch.add_argument("--verify-working", action="store_true", help="require prompt delivery and working or immediate done state")
    launch.add_argument("--human", action="store_true", help="pretty human output instead of JSON")

    send = sub.add_parser("send")
    send.add_argument("--manifest", required=True)
    send.add_argument("--text", required=True)
    send.add_argument("--acknowledge", default=None, help=argparse.SUPPRESS)

    status = sub.add_parser("status")
    status.add_argument("--manifest", required=True)

    prompt = sub.add_parser("prompt", help="submit a complete Pi user turn by stable worker name")
    prompt.add_argument("--name", required=True)
    prompt.add_argument("--file", help="required for multiline or shell-sensitive content")
    prompt.add_argument("--text", help="short literal input only")
    inspect = sub.add_parser("inspect", help="combine native state with Pi session evidence")
    inspect.add_argument("--name", required=True)
    inspect.add_argument("--human", action="store_true", help="pretty human output")
    result = sub.add_parser("result", help="retrieve the complete final Pi assistant result")
    result.add_argument("--name", required=True)
    result.add_argument("--human", action="store_true", help="pretty human output")
    resume = sub.add_parser("resume", help="inspect then continue a named Pi worker")
    resume.add_argument("--name", required=True)
    resume.add_argument("--file", help="required for multiline or shell-sensitive content")
    resume.add_argument("--text", help="short literal input only")
    resume.add_argument("--force", action="store_true", help="permit steering a working worker")
    resume.add_argument("--confirm-completed", action="store_true", help="allow reopening a completed worker")

    await_parser = sub.add_parser("await", help="block until registered workers finish or block")
    await_parser.add_argument("--mailbox", required=True)
    await_parser.add_argument("--name", action="append", default=None, help="registered worker name; repeat to select several")
    await_parser.add_argument("--consumer", default="parent")
    await_mode = await_parser.add_mutually_exclusive_group()
    await_mode.add_argument("--any", dest="wait_all", action="store_false", help="return the next undelivered terminal event")
    await_mode.add_argument("--all", dest="wait_all", action="store_true", help="return after every selected worker is terminal")
    await_parser.set_defaults(wait_all=False)
    await_parser.add_argument("--timeout", dest="wait_timeout", type=float, default=1200.0)
    await_parser.add_argument("--poll-min", type=float, default=0.5, help=argparse.SUPPRESS)
    await_parser.add_argument("--poll-max", type=float, default=10.0, help=argparse.SUPPRESS)
    await_parser.add_argument("--human", action="store_true", help="pretty human output")

    inbox = sub.add_parser("inbox", help="non-blocking delivery of completed worker events")
    inbox.add_argument("--mailbox", required=True)
    inbox.add_argument("--name", action="append", default=None)
    inbox.add_argument("--consumer", default="parent")
    inbox.add_argument("--human", action="store_true", help="pretty human output")

    compatibility = sub.add_parser("compatibility")
    compatibility_sub = compatibility.add_subparsers(dest="compatibility_command", required=True)
    snapshot = compatibility_sub.add_parser("snapshot")
    snapshot.add_argument("--output", help="write sanitized fixture JSON to this path")
    compatibility_sub.add_parser("check")
    docs = sub.add_parser("docs")
    docs_sub = docs.add_subparsers(dest="docs_command", required=True)
    docs_sub.add_parser("check")
    reconcile = sub.add_parser("reconcile")
    reconcile.add_argument("--manifest", default=None)
    reconcile.add_argument("--run", dest="run_id", default=None)
    reconcile.add_argument("--manifest-dir", default=None)
    reconcile.add_argument("--report", default=None)
    reconcile.add_argument("--heartbeat-timeout", type=float, default=300.0)
    reconcile.add_argument("--repository", default=None)
    reconcile.add_argument("--pr", type=int, default=None)

    complete = sub.add_parser("complete")
    complete.add_argument("--manifest", required=True)
    complete.add_argument("--report", required=True)
    complete.add_argument("--repository", required=True)
    complete.add_argument("--pr", type=int, default=None)
    complete.add_argument("--checks-commit", default=None)

    cleanup = sub.add_parser("cleanup")
    cleanup.add_argument("--manifest", required=True)
    cleanup.add_argument("--worktree-root", required=True)
    cleanup.add_argument("--main-checkout", required=True)
    cleanup.add_argument("--current-cwd", default=os.getcwd())
    cleanup.add_argument("--confirm", action="store_true")
    cleanup.add_argument("--require-pushed", dest="require_pushed", action="store_true", default=True)
    cleanup.add_argument("--allow-unpushed", dest="require_pushed", action="store_false")

    watch = sub.add_parser("watch")
    watch.add_argument("--manifest-dir", required=True)
    watch.add_argument("--run-id", required=True)
    watch.add_argument("--worktree-root", required=True)
    watch.add_argument("--main-checkout", required=True)
    watch.add_argument("--current-cwd", default=os.getcwd())
    watch.add_argument("--cleanup", action="store_true")
    watch.add_argument("--require-pushed", action="store_true")
    watch.add_argument("--poll", type=float, default=15.0)
    watch.add_argument("--once", action="store_true")

    args = parser.parse_args(argv)
    if args.version:
        emit({"name": NAME, "version": VERSION})
        return
    if args.brief or not args.command:
        emit({"name": NAME, "version": VERSION, "backend": "herdr", "default_backend": "pi", "backends": ["pi", "hax"], "commands": ["list", "launch", "await", "inbox", "send", "status", "doctor", "reconcile", "complete", "cleanup", "watch"], "session": "--session NAME is mandatory for named-session operations"})
        return
    try:
        mux = adapter(args)
        reservation = None
        launch_manifest_path = None
        launch_admission = None
        if args.command == "launch":
            if args.mailbox and args.backend != "pi":
                raise modern_module.ModernAdapterError("MAILBOX_BACKEND_UNSUPPORTED", "the modern worker mailbox currently supports Pi workers only")
            safe_name = "".join(character if character.isalnum() or character in "_.-" else "-" for character in args.name).strip("-") or "worker"
            launch_manifest_path = Path(args.manifest or f"/tmp/team-task/manifests/{safe_name}.json")
            reservation = dispatch_module.LaunchReservation(launch_manifest_path.parent, mux.config.backend)
            try:
                launch_admission = reservation.acquire()
            except dispatch_module.policy_module.DispatchRefused as exc:
                fail(3, exc.code, str(exc), "wait for a tracked worker to finish or adjust the documented limits")
        if args.command in {"prompt", "inspect", "result", "resume", "await", "inbox", "compatibility", "docs"} or (args.command == "doctor" and args.backend == "pi") or (args.command == "launch" and (args.new_workspace or args.mailbox) and args.backend == "pi"):
            modern = modern_adapter(args)
            if args.command == "doctor":
                capabilities = modern.capabilities()
                missing = [name for name, present in capabilities["commands"].items() if not present]
                emit({"wrapperVersion": VERSION, "herdrVersion": modern.version(), "piVersion": subprocess.run([args.pi_command, "--version"], capture_output=True, text=True, shell=False).stdout.strip() or None, "session": args.session, "capabilities": capabilities, "compatibility": "blocked" if missing else "compatible", "missing": missing})
                return
            if args.command == "compatibility":
                capabilities = modern.capabilities()
                fixture_path = Path(__file__).resolve().parents[1] / "references" / "herdr-0.8.2-preview.schema.json"
                fixture = json.loads(fixture_path.read_text(encoding="utf-8"))
                snapshot = {"sanitized": True, "herdrVersion": modern.version(), "protocol": capabilities["protocol"], "schemaVersion": capabilities["schemaVersion"], "requiredCommands": list(capabilities["commands"]), "agentStates": capabilities["states"]}
                if args.compatibility_command == "snapshot":
                    if args.output:
                        Path(args.output).write_text(json.dumps(snapshot, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
                    emit(snapshot); return
                missing = [name for name in fixture["requiredCommands"] if not capabilities["commands"].get(name)]
                changed_states = fixture["agentStates"] != capabilities["states"]
                emit({"herdrVersion": modern.version(), "latestTested": fixture["herdrVersion"], "compatible": [name for name in fixture["requiredCommands"] if name not in missing], "missing": missing, "changedStates": changed_states, "result": "blocked" if missing else ("unknown" if changed_states else "compatible")})
                return
            if args.command == "docs":
                documented = Path(__file__).resolve().parents[1] / "SKILL.md"
                required = ["launch", "await", "inbox", "inspect", "prompt", "resume", "result", "doctor", "compatibility check", "docs check"]
                content = documented.read_text(encoding="utf-8")
                missing = [item for item in required if item not in content]
                if missing:
                    raise modern_module.ModernAdapterError("DOCS_DRIFT", "SKILL.md omits tested wrapper commands", details={"missing": missing})
                emit({"ok": True, "checked": required})
                return
            if args.command == "launch":
                if args.mailbox and not args.run_id:
                    raise modern_module.ModernAdapterError("RUN_ID_REQUIRED", "--mailbox requires an explicit --run-id")
                if args.mailbox and args.backend != "pi":
                    raise modern_module.ModernAdapterError("MAILBOX_BACKEND_UNSUPPORTED", "the modern worker mailbox currently supports Pi workers only")
                brief = modern_module.ModernHerdrAdapter.read_prompt(args.brief_file)
                workspace = modern.create_workspace(args.cwd, args.name) if args.new_workspace else {"workspace_id": args.workspace}
                workspace_id = str(workspace.get("workspace_id") or workspace.get("id") or "")
                if not workspace_id:
                    raise modern_module.ModernAdapterError("WORKSPACE_REQUIRED", "modern launch requires --new-workspace or --workspace")
                started = modern.start_worker(name=args.name, cwd=args.cwd, workspace_id=workspace_id, provider=args.provider, model=args.model, thinking=args.thinking, extension=args.extension)
                try:
                    dispatched = modern.prompt_worker({"name": args.name}, brief, wait_for_working=args.verify_working)
                except modern_module.ModernAdapterError as exc:
                    raise modern_module.ModernAdapterError("DISPATCH_FAILED_AFTER_START", "worker startup succeeded but brief dispatch failed", details={"workspaceId": workspace_id, "paneId": started.get("pane_id"), "cause": exc.code}) from exc
                native = dispatched.get("agent_status") or dispatched.get("status")
                if args.verify_working and native not in {"working", "done"}:
                    raise modern_module.ModernAdapterError("LAUNCH_NOT_WORKING", "brief was delivered but worker did not transition to working or done", details={"nativeStatus": native, "workspaceId": workspace_id, "paneId": started.get("pane_id")})
                registration = None
                if args.mailbox:
                    registration = mailbox_module.MailboxStore(args.mailbox).register(run_id=args.run_id, name=args.name, workspace_id=workspace_id, pane_id=str(started.get("pane_id") or ""))
                manifest = adapter_module.hax_backend.worker_manifest(
                    config=mux.config, runtime="herdr", run_id=args.run_id or f"run-{int(time.time())}", label=args.name,
                    workspace_id=workspace_id, tab_id=str(started.get("tab_id") or "unknown"), pane_id=str(started.get("pane_id") or "unknown"),
                    cwd=args.cwd, state="working" if native == "working" else "verifying", branch=args.branch or branch_for(args.cwd),
                    worktree=os.path.abspath(args.worktree or args.cwd), dispatch_admission=launch_admission,
                )
                write_manifest(str(launch_manifest_path), manifest)
                reservation.release()
                payload = {"launched": True, "runId": args.run_id, "worker": args.name, "workspaceId": workspace_id, "paneId": started.get("pane_id"), "process": started.get("terminal_id"), "sessionArtifact": started.get("agent_session"), "provider": args.provider, "model": args.model, "thinking": args.thinking, "nativeStatus": native, "mailbox": args.mailbox, "registration": registration, "manifest_path": str(launch_manifest_path), "dispatch_admission": launch_admission}
                if getattr(args, "human", False):
                    _human_launch(payload)
                else:
                    emit(payload)
                return
            if args.command == "await":
                if args.wait_timeout < 0 or args.poll_min <= 0 or args.poll_max < args.poll_min:
                    raise modern_module.ModernAdapterError("WAIT_CONFIG_INVALID", "timeout and polling bounds are invalid")
                mailbox = mailbox_module.MailboxStore(args.mailbox)
                payload = await_mailbox(modern, mailbox, names=args.name, consumer=args.consumer, wait_all=args.wait_all,
                                   timeout=args.wait_timeout, poll_min=args.poll_min, poll_max=args.poll_max)
                if getattr(args, "human", False):
                    _human_events(payload.get("events", []), args.mailbox)
                    if not payload.get("waitSatisfied"):
                        print(f"wait pending: {', '.join(payload.get('pending', []))}")
                else:
                    emit(payload)
                return
            if args.command == "inbox":
                mailbox = mailbox_module.MailboxStore(args.mailbox)
                registrations = mailbox.workers(args.name)
                events = mailbox.deliver(consumer=args.consumer, names=args.name)
                if not events:
                    observe_mailbox(modern, mailbox, registrations)
                    events = mailbox.deliver(consumer=args.consumer, names=args.name)
                enriched = enrich_mailbox_events(events)
                if getattr(args, "human", False):
                    _human_events(enriched, args.mailbox)
                else:
                    emit({"events": enriched, "count": len(enriched)})
                return
            worker = modern.resolve_worker(args.name)
            if args.command == "inspect":
                data = modern.inspect_worker(worker)
                if getattr(args, "human", False):
                    print(f"{data.get('name')} · {data.get('nativeStatus')} → {data.get('interpretation')}  workspace {_shorten_path(str(data.get('workspaceId')))} pane {data.get('paneId')}")
                    if data.get("sessionArtifact"):
                        print(f"  artifact: {_shorten_path(str(data.get('sessionArtifact')))}")
                else:
                    emit(data)
                return
            if args.command == "result":
                data = modern.result(worker)
                if getattr(args, "human", False):
                    print(f"✓ {data.get('name')} — {_shorten_path(str(data.get('sessionArtifact')))}")
                    print(data.get("result", ""))
                else:
                    emit(data)
                return
            if args.command == "prompt":
                text = prompt_text(args)
                sent = modern.prompt_worker(worker, text)
                emit({"name": args.name, "workspaceId": worker.get("workspace_id"), "paneId": worker.get("pane_id"), "submitted": True, "nativeStatus": sent.get("agent_status") or sent.get("status")}); return
            if args.command == "resume":
                inspection = modern.inspect_worker(worker)
                if inspection["interpretation"] == "working" and not args.force:
                    raise modern_module.ModernAdapterError("WORKER_WORKING", "refusing to interrupt a working worker; use --force for deliberate steering", safety=True)
                if inspection["interpretation"] == "completed" and not args.confirm_completed:
                    raise modern_module.ModernAdapterError("WORKER_COMPLETED", "completed work requires --confirm-completed before reopening", safety=True)
                if inspection["nativeStatus"] == "blocked":
                    raise modern_module.ModernAdapterError("WORKER_BLOCKED", "worker is blocked; resolve its blocker before continuing", details={"inspection": inspection}, safety=True)
                text = prompt_text(args)
                sent = modern.prompt_worker(worker, text)
                emit({"name": args.name, "workspaceId": worker.get("workspace_id"), "paneId": worker.get("pane_id"), "resumed": True, "nativeStatus": sent.get("agent_status") or sent.get("status")}); return
        if args.command == "doctor":
            payload = {"backend": mux.config.backend, "runtime": "herdr", "capabilities": mux.hax.capabilities(mux.config, runtime="herdr")}
            if mux.config.backend == "hax":
                payload["diagnostics"] = mux.hax.diagnostics(mux.config, runtime="herdr")
            else:
                payload["default"] = True
            emit(payload)
            return
        if args.command == "complete":
            manifest = read_manifest(args.manifest)
            evidence, details = completion_evidence(args, manifest, args.report)
            updated = state_module.transition(manifest, "complete", evidence)
            store_module.ManifestStore.from_path(args.manifest).write(updated)
            emit({"manifest": updated, "evidence": details, "state": "complete"})
            return
        if args.command == "cleanup":
            manifest = read_manifest(args.manifest)
            manifest.setdefault("session", args.session)
            manifest.setdefault("herdr_command", args.herdr_command)
            store = store_module.ManifestStore.from_path(args.manifest)
            def close_worker(value):
                if value.get("backend") == "hax":
                    value["backend_shutdown"] = mux.stop(value)
                    store.write(value)
                cleanup_module.CleanupManager._close_workspace(value)
            manager = cleanup_module.CleanupManager(
                worktree_root=args.worktree_root, main_checkout=args.main_checkout, current_cwd=args.current_cwd,
                manifest_writer=store.write, workspace_closer=close_worker,
            )
            emit(manager.cleanup(manifest, confirm=args.confirm, require_pushed=args.require_pushed))
            return
        if args.command == "watch":
            paths = sorted(glob.glob(os.path.join(args.manifest_dir, "*.json")))
            def factory(manifest):
                path = manifest.get("_manifest_path")
                store = store_module.ManifestStore.from_path(path) if path else None
                def save(value):
                    if store:
                        store.write({key: val for key, val in value.items() if key != "_manifest_path"})
                return cleanup_module.CleanupManager(
                    worktree_root=args.worktree_root, main_checkout=args.main_checkout, current_cwd=args.current_cwd,
                    manifest_writer=save)
            while True:
                for path in paths:
                    value = cleanup_module.load_manifest(path)
                    if value is not None:
                        value["_manifest_path"] = path
                result = cleanup_module.watch_once(paths, run_id=args.run_id, manager_factory=factory,
                                                   cleanup_enabled=args.cleanup, require_pushed=args.require_pushed)
                emit(result)
                if args.once or result["tracked"] == 0 or result["remaining"] == 0:
                    return
                time.sleep(args.poll)
        if args.command == "list":
            result = mux.preflight()
            panes = result.get("panes", [])
            if args.human:
                print("\n".join(f"{p.get('pane_id') or p.get('id')}  {p.get('agent') or p.get('title', '')}  {p.get('agent_state') or p.get('state', '')}" for p in panes))
            else:
                emit({"session": mux._resolved_session, "panes": panes, "count": len(panes)})
            return
        if args.command == "launch":
            cwd = os.path.abspath(args.cwd)
            worktree = os.path.abspath(args.worktree or cwd)
            run_id = args.run_id or f"run-{int(time.time())}"
            value = mux.launch(run_id=run_id, label=args.name, cwd=cwd, worktree=worktree,
                               branch=args.branch or branch_for(cwd), brief_file=args.brief_file,
                               workspace_id=args.workspace, model=args.model or "opencode/deepseek-v4-flash-free", thinking=args.thinking,
                               setup_timeout=args.setup_timeout)
            value["session"] = args.session
            value["herdr_command"] = args.herdr_command
            value["dispatch_admission"] = launch_admission
            backend_output = value.pop("_backend_output", None)
            write_manifest(str(launch_manifest_path), value)
            reservation.release()
            if backend_output:
                value["backend_output"] = backend_output
            value["manifest_path"] = str(launch_manifest_path)
            emit(value)
            return
        if args.command == "reconcile":
            manifest_path = resolve_manifest_path(args)
            manifest = read_manifest(manifest_path)
            result = mux.reconcile(manifest, heartbeat_timeout=args.heartbeat_timeout, report_path=args.report)
            issues = list(result.get("issues", []))
            report_path = args.report or manifest.get("report_path")
            report = None
            try:
                if not report_path:
                    raise git_gate_module.GateError("REPORT_MISSING", "reconcile requires a final worker report")
                report = git_gate_module.parse_worker_report(report_path, expected_worktree=manifest.get("worktree"), expected_branch=manifest.get("branch"))
            except git_gate_module.GateError as exc:
                issues.append(exc.code)
                report = {"error": exc.code}
            git_evidence = {}
            try:
                git_evidence = git_gate_module.GitGate(git_command=args.git_command, gh_command=args.gh_command).verify_worktree(
                    worktree=manifest["worktree"], expected_worktree=manifest["worktree"], expected_branch=manifest["branch"], require_upstream=True)
            except (KeyError, git_gate_module.GateError) as exc:
                code = getattr(exc, "code", "GIT_EVIDENCE_MISSING")
                issues.append(code)
                git_evidence = {"error": code}
            evidence = {"head_sha": git_evidence.get("head_sha"), "pushed_sha": git_evidence.get("pushed_sha"),
                        "pr_number": manifest.get("pr_number"), "review_status": manifest.get("review_status"),
                        "checks_status": manifest.get("checks_status"), "worktree_clean": git_evidence.get("clean") is True,
                        "synchronized": git_evidence.get("synchronized") is True}
            completion = git_gate_module.completion_gate(git=git_evidence, review_status=evidence["review_status"], checks_status=evidence["checks_status"])
            state_machine = {"ok": False, "error": "not_checked"}
            try:
                probe = dict(manifest)
                probe["state"] = "review_pending"
                state_machine = {"ok": True, "state": state_module.transition(probe, "complete", evidence)["state"]}
            except ValueError as exc:
                state_machine = {"ok": False, "error": getattr(exc, "code", "STATE_MACHINE_REJECTED")}
                issues.append(state_machine["error"])
            result.update({"manifest_path": manifest_path, "report": report, "git_gate": git_evidence,
                           "completion_gate": completion, "state_machine": state_machine})
            if not completion["ok"]:
                issues.append(completion["state"])
            result["issues"] = sorted(set(issues))
            result["ok"] = not result["issues"]
            emit(result)
            return
        manifest = read_manifest(args.manifest)
        if args.command == "send":
            emit(mux.send(manifest, args.text, acknowledge=args.acknowledge))
        elif args.command == "status":
            emit(mux.status(manifest))
    except cleanup_module.CleanupError as exc:
        fail(3 if exc.code == "CLEANUP_REFUSED" else 2, exc.code, str(exc), json.dumps(exc.details, sort_keys=True) if exc.details else None)
    except modern_module.ModernAdapterError as exc:
        modern_error(exc)
    except mailbox_module.MailboxError as exc:
        fail(3 if exc.code in {"RUN_ID_CONFLICT", "WORKER_IDENTITY_CONFLICT"} else 2, exc.code, str(exc), json.dumps(exc.details, sort_keys=True) if exc.details else None)
    except adapter_module.AdapterError as exc:
        fail(2, exc.code, str(exc), json.dumps(exc.details, sort_keys=True) if exc.details else None)


if __name__ == "__main__":
    main()
